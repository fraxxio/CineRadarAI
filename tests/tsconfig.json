{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "incremental": false,
    // replaces the root paths, so "@/*" is repeated
    "paths": {
      "@/*": ["../src/*"],
      "@test/*": ["./*"]
    }
  },
  "include": [
    "../next-env.d.ts",
    "../src/**/*",
    "**/*",
    "../vitest.config.mts",
    "../playwright.config.ts",
    "../drizzle.test.config.ts"
  ],
  "exclude": [".generated"]
}
